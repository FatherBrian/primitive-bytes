---
import type { Entry } from '../lib/posts';
import { readingTime } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	entries: Entry[];
	/** Notes on the home page: date and title only. */
	compact?: boolean;
}

const { entries, compact = false } = Astro.props;
---

<ol class:list={['posts', { compact }]}>
	{
		entries.map((e) => (
			<li>
				<a href={e.href}>
					<div class="meta eyebrow">
						{e.kind === 'note' && <span class="kind">Note</span>}
						<FormattedDate date={e.pubDate} />
						{!compact && (
							<>
								<span aria-hidden="true">·</span>
								<span>{readingTime(e.body)} min read</span>
							</>
						)}
					</div>
					<h3>
						{e.title}
						<span class="arrow" aria-hidden="true">
							→
						</span>
					</h3>
					{!compact && <p>{e.description}</p>}
					{!compact && e.tags.length > 0 && (
						<div class="tags">
							{e.tags.map((t) => (
								<span class="chip">{t}</span>
							))}
						</div>
					)}
				</a>
			</li>
		))
	}
</ol>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}
	li {
		border-bottom: 1px solid var(--rule);
	}
	a {
		display: block;
		padding: 1.75rem 0;
		color: inherit;
		text-decoration: none;
	}
	.compact a {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
		padding: 1rem 0;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}
	.compact .meta {
		flex: none;
		width: 7.5rem;
		margin: 0;
	}
	.kind {
		padding: 0.1em 0.5em;
		border-radius: 4px;
		background: var(--accent-wash);
		color: var(--accent-ink);
	}
	.compact .kind {
		display: none;
	}
	h3 {
		margin: 0 0 0.35rem;
		font-size: 1.45rem;
		transition: color 0.15s ease;
	}
	.compact h3 {
		margin: 0;
		font-size: 1.08rem;
		font-weight: 500;
	}
	.arrow {
		display: inline-block;
		margin-left: 0.25rem;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}
	a:hover h3 {
		color: var(--accent-ink);
	}
	a:hover .arrow {
		opacity: 1;
		transform: none;
	}
	p {
		margin: 0;
		max-width: 62ch;
		color: var(--ink-2);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.9rem;
	}
	@media (max-width: 520px) {
		.compact a {
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
