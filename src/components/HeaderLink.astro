---
import type { HTMLAttributes } from 'astro/types';
import { url } from '../url';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const here = Astro.url.pathname.replace(/\/?$/, '/');
const target = String(href ?? '').replace(/\/?$/, '/');
const home = url().replace(/\/?$/, '/');
const isActive = target === home ? here === home : here.startsWith(target);
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
<style>
	a {
		position: relative;
		padding: 0.35rem 0.7rem;
		border-radius: 8px;
		color: var(--ink-2);
		font-size: 0.92rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}
	a:hover {
		color: var(--ink);
		background: var(--paper-2);
	}
	a.active {
		color: var(--ink);
	}
	a.active::after {
		content: '';
		position: absolute;
		left: 0.7rem;
		right: 0.7rem;
		bottom: -0.55rem;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
	}
</style>
