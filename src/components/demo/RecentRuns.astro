---
// The newest saved runs that are listed (preset questions only), as cards linking to replays.
interface Props {
	limit?: number;
}

const { limit = 6 } = Astro.props;
const api = import.meta.env.PUBLIC_DEMO_API ?? '';
---

<div class="recent" data-recent data-api={api} data-limit={limit}>
	<p class="muted" data-recent-note>{api ? 'Loading recent runs…' : 'Runs show up here once the demo server is set up.'}</p>
	<div class="cards" data-recent-cards></div>
</div>

<script>
	import { url } from '../../url';

	type J = Record<string, any>;

	function ago(iso: string) {
		const s = Math.max(1, Math.round((Date.now() - Date.parse(iso)) / 1000));
		const [n, unit] = s < 3600 ? [Math.round(s / 60) || 1, 'min'] : s < 86400 ? [Math.round(s / 3600), 'h'] : [Math.round(s / 86400), 'd'];
		return `${n} ${unit} ago`;
	}

	function el(tag: string, cls: string, text?: string) {
		const e = document.createElement(tag);
		if (cls) e.className = cls;
		if (text !== undefined) e.textContent = text;
		return e;
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-recent]')) {
		const api = root.dataset.api;
		const note = root.querySelector<HTMLElement>('[data-recent-note]')!;
		const cards = root.querySelector<HTMLElement>('[data-recent-cards]')!;
		if (!api) continue;
		fetch(`${api}/api/runs?limit=${root.dataset.limit}`)
			.then((r) => (r.ok ? r.json() : Promise.reject()))
			.then(({ runs }: { runs: J[] }) => {
				if (!runs.length) {
					note.textContent = 'No runs yet. Be the first: try a preset in the playground.';
					return;
				}
				note.remove();
				cards.replaceChildren(
					...runs.map((r) => {
						const a = el('a', 'run') as HTMLAnchorElement;
						a.href = url(`/lab/run/?id=${encodeURIComponent(r.id)}`);
						const top = el('div', 'top');
						top.append(el('b', '', r.title), el('span', 'when', ago(r.created_at)));
						const chips = el('div', 'chips');
						for (const hl of r.highlights ?? []) chips.append(el('span', `chip ${hl.kind}`, hl.text));
						chips.append(el('span', 'chip', `${r.calls} tool call${r.calls === 1 ? '' : 's'}`));
						a.append(top, el('p', 'setup', r.setup), chips);
						if (r.answer) a.append(el('p', 'answer', `“${r.answer}${r.answer.length >= 160 ? '…' : ''}”`));
						return a;
					}),
				);
			})
			.catch(() => {
				note.textContent = "Couldn't load recent runs right now.";
			});
	}
</script>

<style>
	.muted {
		color: var(--ink-3);
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 0.75rem;
	}
	.cards :global(.run) {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--paper-2);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease;
	}
	.cards :global(.run:hover) {
		border-color: var(--accent);
	}
	.cards :global(.top) {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		align-items: baseline;
	}
	.cards :global(.when) {
		flex: none;
		color: var(--ink-3);
		font-family: var(--font-mono), monospace;
		font-size: 0.72rem;
	}
	.cards :global(.setup) {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.82rem;
		line-height: 1.45;
	}
	.cards :global(.chips) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.cards :global(.chip) {
		padding: 0.05rem 0.5rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		color: var(--ink-2);
		font-family: var(--font-mono), monospace;
		font-size: 0.7rem;
	}
	.cards :global(.chip.bad) {
		border-color: rgba(214, 69, 65, 0.45);
		color: #d64541;
	}
	.cards :global(.chip.good) {
		border-color: rgba(46, 160, 90, 0.45);
		color: #2e9a5a;
	}
	.cards :global(.answer) {
		margin: 0;
		color: var(--ink-3);
		font-size: 0.8rem;
		font-style: italic;
		line-height: 1.45;
	}
</style>
