---
// "Run it live": one real agent run on the demo API, streamed step by step.
import Transcript from './Transcript.astro';

interface Props {
	scenario: string;
	options: { value: string; label: string }[];
	intro: string;
}

const { scenario, options, intro } = Astro.props;
const api = import.meta.env.PUBLIC_DEMO_API ?? '';
---

<section class="live" data-live data-api={api} data-scenario={scenario}>
	<div class="top">
		<div>
			<p class="eyebrow">Live · Claude Haiku 5.5</p>
			<h2>Run it with a real model</h2>
			<p class="intro">{intro}</p>
		</div>
	</div>
	<div class="controls">
		{
			options.map((o, i) => (
				<label class="opt">
					<input type="radio" name={`live-${scenario}`} value={o.value} checked={i === 0} />
					<span>{o.label}</span>
				</label>
			))
		}
		<button type="button" data-run disabled={!api}>Run</button>
	</div>
	<p class="note" data-note>
		{api ? 'Each run is a real model call through the real Reef and Trellis, on fake data.' : 'Live runs are coming soon.'}
	</p>
	<Transcript />
	<p class="share" data-share hidden></p>
</section>

<script>
	import { runLink, showEvent, type Ev } from './transcript';

	for (const root of document.querySelectorAll<HTMLElement>('[data-live]')) {
		const api = root.dataset.api!;
		const steps = root.querySelector<HTMLElement>('[data-steps]')!;
		const note = root.querySelector<HTMLElement>('[data-note]')!;
		const share = root.querySelector<HTMLElement>('[data-share]')!;
		const button = root.querySelector<HTMLButtonElement>('[data-run]')!;
		let runId = '';

		function offerLink() {
			const link = runLink(runId);
			const a = document.createElement('a');
			a.href = link;
			a.textContent = 'Link to this run';
			const copy = document.createElement('button');
			copy.type = 'button';
			copy.className = 'copy';
			copy.textContent = 'Copy link';
			copy.addEventListener('click', () => {
				navigator.clipboard?.writeText(link).then(() => (copy.textContent = 'Copied'));
			});
			share.replaceChildren(a, copy);
			share.hidden = false;
		}

		function show(e: Ev) {
			if (e.type === 'run') {
				runId = e.id;
			} else if (e.type === 'done') {
				note.textContent = `Done. This run cost $${Number(e.cost_usd).toFixed(4)}.`;
				if (runId) offerLink();
			} else {
				showEvent(steps, e);
			}
		}

		button.addEventListener('click', async () => {
			const option = root.querySelector<HTMLInputElement>('input[type=radio]:checked')?.value;
			steps.innerHTML = '';
			share.hidden = true;
			runId = '';
			note.textContent = 'Running…';
			button.disabled = true;
			try {
				const res = await fetch(`${api}/api/run`, {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ scenario: root.dataset.scenario, option }),
				});
				if (!res.ok || !res.body) {
					const body = await res.json().catch(() => ({}));
					note.textContent = body.error ?? `The demo server said ${res.status}.`;
					return;
				}
				const reader = res.body.getReader();
				const decoder = new TextDecoder();
				let buffer = '';
				for (;;) {
					const { value, done } = await reader.read();
					if (done) break;
					buffer += decoder.decode(value, { stream: true });
					let cut;
					while ((cut = buffer.indexOf('\n\n')) >= 0) {
						const chunk = buffer.slice(0, cut);
						buffer = buffer.slice(cut + 2);
						if (chunk.startsWith('data: ')) show(JSON.parse(chunk.slice(6)));
					}
				}
			} catch {
				note.textContent = "Couldn't reach the demo server. Try again in a minute.";
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	.live {
		margin: 2.5rem 0;
		padding: 1.5rem;
		border: 1px solid var(--accent);
		border-radius: var(--radius);
		background: linear-gradient(180deg, var(--accent-wash), transparent 140px), var(--paper);
	}
	.eyebrow {
		margin: 0 0 0.4rem;
		color: var(--accent-ink);
	}
	h2 {
		margin: 0 0 0.4rem;
		font-size: 1.35rem;
	}
	.intro {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.1rem;
	}
	.opt {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: var(--paper);
		font-size: 0.88rem;
		cursor: pointer;
	}
	.opt:has(input:checked) {
		border-color: var(--accent);
		color: var(--accent-ink);
	}
	[data-run] {
		margin-left: auto;
		padding: 0.5rem 1.25rem;
		border: 0;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	[data-run]:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.note {
		margin: 0.8rem 0 0;
		color: var(--ink-3);
		font-size: 0.85rem;
	}
	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin: 0.75rem 0 0;
		font-size: 0.88rem;
	}
	.share[hidden] {
		display: none;
	}
	.share :global(a) {
		color: var(--accent-ink);
		font-weight: 600;
	}
	.share :global(.copy) {
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink-2);
		font: inherit;
		font-size: 0.8rem;
		cursor: pointer;
	}
	@media (max-width: 640px) {
		.live {
			padding: 1rem;
		}
		[data-run] {
			margin-left: 0;
			width: 100%;
		}
	}
</style>
