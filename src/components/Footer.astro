---
import { GITHUB_URL, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { url } from '../url';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap inner">
		<div class="brand">
			<Logo size={18} />
			<div>
				<strong>{SITE_TITLE}</strong>
				<p>{SITE_TAGLINE}</p>
			</div>
		</div>
		<nav aria-label="Footer">
			<a href={url('/blog/')}>Writing</a>
			<a href={url('/lab/')}>Lab</a>
			<a href={url('/about/')}>About</a>
			<a href={url('/rss.xml')}>RSS</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
		</nav>
	</div>
	<div class="wrap legal">&copy; {year} {SITE_TITLE}</div>
</footer>

<style>
	footer {
		margin-top: 6rem;
		padding: 2.5rem 0 3rem;
		border-top: 1px solid var(--rule);
		color: var(--ink-3);
		font-size: 0.88rem;
	}
	.inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}
	.brand {
		display: flex;
		gap: 0.75rem;
		max-width: 26rem;
	}
	.brand :global(svg) {
		margin-top: 0.25rem;
		flex: none;
	}
	strong {
		color: var(--ink);
		font-family: var(--font-display), system-ui, sans-serif;
	}
	p {
		margin: 0.15rem 0 0;
		line-height: 1.5;
	}
	nav {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
	}
	nav a {
		color: var(--ink-2);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--accent-ink);
	}
	.legal {
		margin-top: 2rem;
		font-family: var(--font-mono), ui-monospace, monospace;
		font-size: 0.75rem;
	}
</style>
