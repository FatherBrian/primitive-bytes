---
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE, TOPICS } from '../consts';
import Page from '../layouts/Page.astro';
import { DEMOS } from '../data/work';
import { allNotes, allPosts, noteEntry, postEntry } from '../lib/posts';
import { url } from '../url';

const posts = (await allPosts()).map(postEntry);
const notes = (await allNotes()).map(noteEntry);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero wrap">
		<p class="eyebrow">A blog by FatherBrian</p>
		<h1>{SITE_TAGLINE}</h1>
		<p class="lede">
			I like data and AI, and post about them sometimes. The rest is whatever I'm building at
			the moment: some of it useful, some of it just for fun.
		</p>
		<ul class="topics" aria-label="Topics">
			{
				TOPICS.map((t) => (
					<li class="chip">{t}</li>
				))
			}
		</ul>
	</section>

	<section class="latest wrap">
		<div class="section-head">
			<h2>Latest writing</h2>
			<a href={url('/blog/')}>All posts →</a>
		</div>
		<PostList entries={posts.slice(0, 6)} />
	</section>

	<section class="try wrap">
		<div class="section-head">
			<h2>Try a demo</h2>
			<a href={url('/work/')}>All work →</a>
		</div>
		<div class="demo-row">
			{
				DEMOS.map((d) => (
					<a class="demo-link" href={url(d.path)}>
						<strong>{d.title}</strong>
						<span>{d.blurb}</span>
					</a>
				))
			}
		</div>
	</section>

	{
		notes.length > 0 && (
			<section class="notes wrap">
				<div class="section-head">
					<h2>Notes</h2>
					<span class="hint">Shorter, and about anything</span>
				</div>
				<PostList entries={notes.slice(0, 8)} compact />
			</section>
		)
	}
</Page>

<style>
	.hero {
		padding-top: 6rem;
		padding-bottom: 4rem;
		position: relative;
	}
	.hero::before {
		/* a faint grid of blocks behind the headline */
		content: '';
		position: absolute;
		inset: 1.5rem 1.25rem auto auto;
		width: min(340px, 45%);
		height: 260px;
		background-image:
			linear-gradient(var(--rule) 1px, transparent 1px),
			linear-gradient(90deg, var(--rule) 1px, transparent 1px);
		background-size: 28px 28px;
		mask-image: radial-gradient(closest-side, #000 40%, transparent);
		-webkit-mask-image: radial-gradient(closest-side, #000 40%, transparent);
		opacity: 0.8;
		pointer-events: none;
	}
	.hero > * {
		position: relative;
	}
	.eyebrow {
		margin: 0 0 1.25rem;
		color: var(--accent-ink);
	}
	h1 {
		max-width: 17ch;
		margin-bottom: 1.5rem;
	}
	.lede {
		max-width: 58ch;
		margin: 0;
		color: var(--ink-2);
		font-size: 1.2rem;
		line-height: 1.6;
	}
	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.15rem;
	}
	.section-head a {
		color: var(--ink-2);
		font-size: 0.92rem;
		font-weight: 500;
		text-decoration: none;
	}
	.section-head a:hover {
		color: var(--accent-ink);
	}
	.notes,
	.try {
		margin-top: 4.5rem;
	}
	.demo-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 0.75rem;
	}
	.demo-link {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--rule);
		border-left: 3px solid var(--accent);
		border-radius: var(--radius);
		background: var(--paper-2);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			border-color 0.15s ease;
	}
	.demo-link:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
	}
	.demo-link strong {
		font-family: var(--font-display), system-ui, sans-serif;
		font-size: 1.1rem;
	}
	.demo-link span {
		color: var(--ink-2);
		font-size: 0.92rem;
		line-height: 1.5;
	}
	@media (max-width: 640px) {
		.demo-row {
			grid-template-columns: 1fr;
		}
	}
	.hint {
		color: var(--ink-3);
		font-size: 0.92rem;
	}
	@media (max-width: 640px) {
		.hero {
			padding-top: 3.5rem;
			padding-bottom: 2.75rem;
		}
		.hero::before {
			display: none;
		}
		.lede {
			font-size: 1.08rem;
		}
	}
</style>
