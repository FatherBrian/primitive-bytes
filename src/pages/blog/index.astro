---
import PostList from '../../components/PostList.astro';
import { SITE_DESCRIPTION } from '../../consts';
import Page from '../../layouts/Page.astro';
import { allPosts } from '../../lib/posts';

const posts = await allPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))];
---

<Page title="Writing" description={SITE_DESCRIPTION}>
	<section class="wrap">
		<header class="head">
			<p class="eyebrow">Writing</p>
			<h1>Everything, newest first.</h1>
			<p class="dek">
				{posts.length}
				{posts.length === 1 ? 'post' : 'posts'} on data and AI governance, and the platforms underneath.
			</p>
		</header>
		{
			years.map((year) => (
				<div class="year">
					<h2 class="eyebrow">{year}</h2>
					<PostList posts={posts.filter((p) => p.data.pubDate.getFullYear() === year)} />
				</div>
			))
		}
	</section>
</Page>

<style>
	.head {
		padding: 4.5rem 0 2.5rem;
	}
	.head .eyebrow {
		margin: 0 0 1rem;
		color: var(--accent-ink);
	}
	h1 {
		margin-bottom: 0.75rem;
	}
	.dek {
		margin: 0;
		color: var(--ink-2);
		font-size: 1.15rem;
	}
	.year + .year {
		margin-top: 3rem;
	}
	.year h2 {
		margin: 0 0 0.5rem;
		font-family: var(--font-mono), ui-monospace, monospace;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
	}
	@media (max-width: 640px) {
		.head {
			padding-top: 2.75rem;
		}
	}
</style>
