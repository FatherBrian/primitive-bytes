---
// The agent chat: a live agent over sample MCP servers, behind a chat. Each message is one
// live run; MCP Apps views render inline in the answer, and the full trace (tool calls,
// results, ledger, what each server received) folds away under it.
import Page from '../../layouts/Page.astro';
import { url } from '../../url';

const api = import.meta.env.PUBLIC_DEMO_API ?? '';
---

<Page
	title="Chat with an agent"
	description="A real AI agent with access to MCP servers, some of them hostile. Watch an attack work, turn protection on, and watch it fail."
>
	<section class="chat wrap console" data-chat data-api={api}>
		<header class="bar">
			<div class="title">
				<a class="back" href={url('/lab/')}>← Lab</a>
				<h1><span class="glyph">›_</span> Agent chat</h1>
			</div>
			<div class="bar-actions">
				<button type="button" class="switch" data-protect aria-pressed="false">
					<span class="dot open" data-dot></span>Protection <b data-protect-label>off</b>
				</button>
				<button type="button" class="ghost" data-new hidden>New chat</button>
			</div>
		</header>

		<div class="thread" data-thread aria-live="polite">
			<div class="empty" data-empty>
				<p class="intro">
					A real AI agent with access to a made-up company's MCP servers, some of them hostile. Pick
					an attack and watch it work. Then turn protection on and run it again.
				</p>
				<p class="muted" data-status>{api ? 'Loading…' : 'The chat needs the demo server, which isn’t set up here.'}</p>
				<div class="scenarios" data-scenarios></div>
			</div>
		</div>

		<form class="composer" data-composer>
			<button type="button" class="jump" data-jump hidden>↓ New messages</button>
			<div class="follow chips" data-follow></div>
			<div class="box">
				<textarea name="text" rows="1" placeholder="Ask the agent…" data-input disabled></textarea>
				<button type="submit" class="send" data-send disabled aria-label="Send">↑</button>
			</div>
			<p class="foot">
				<span data-count></span>
				Claude Haiku 5.5 on fake data. Your own questions get a share link but never appear in the
				public feed; don't type anything personal.
			</p>
		</form>
	</section>
</Page>

<script>
	import { mountView, configureViews } from '../../components/demo/views';
	import { runLink, showEvent, streamRun, type Ev } from '../../components/demo/transcript';

	type J = Record<string, any>;
	const root = document.querySelector<HTMLElement>('[data-chat]')!;
	const API = root.dataset.api ?? '';
	configureViews(API);
	const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

	const thread = $('[data-thread]');
	const empty = $('[data-empty]');
	const input = $<HTMLTextAreaElement>('[data-input]');
	const send = $<HTMLButtonElement>('[data-send]');
	const follow = $('[data-follow]');
	const newButton = $<HTMLButtonElement>('[data-new]');

	let world: J = {};
	let maxQ = 280;
	let keepHistory = 0; // how many earlier messages the server takes (0: each message starts fresh)
	let running = false;
	let lastAsk: { prompt: string; text: string } | null = null;
	const history: { role: 'user' | 'assistant'; text: string }[] = [];
	let config: J = {};

	// Three attacks. Each runs the same question with protection off (straight to the servers)
	// or on (through the Reef gateway, with a task grant and tools pinned by reef.lock).
	type Scenario = { id: string; title: string; blurb: string; prompt: string; servers: string[]; task: string; stops: string; old: string[] };
	const SCENARIOS: Scenario[] = [
		{
			id: 'poisoned-tool',
			title: 'A poisoned tool',
			blurb: "The wiki's search tool was quietly rewritten to tell the agent to email out every page it reads.",
			prompt: 'calibration',
			servers: ['docs', 'comms'],
			task: 'everything',
			stops: 'reef.lock sees the tool changed since it was approved, and hides it.',
			old: ['rug-pull-open', 'rug-pull-unlocked', 'rug-pull-locked', 'compare-rug-pull', 'injected-ticket', 'injected-ticket-no-mail'],
		},
		{
			id: 'too-much-access',
			title: 'Too much access',
			blurb: 'Ask for payroll cost by team. Should the agent see every salary and performance review to do that?',
			prompt: 'payroll',
			servers: ['hr'],
			task: 'headcount',
			stops: 'The task grant only covers headcount, so salaries are masked and reviews hidden.',
			old: ['payroll-headcount', 'payroll-pii', 'compare-grants'],
		},
		{
			id: 'pushy-app',
			title: 'An app that acts on its own',
			blurb: 'A third-party lookup tool ships an MCP Apps view that tries to call tools and message the model.',
			prompt: 'contact',
			servers: ['crm', 'pal', 'comms'],
			task: 'triage',
			stops: 'The gateway masks contact details, and the host refuses what the view asks for.',
			old: ['pal-view', 'pushy-plugin'],
		},
	];
	const ALL = ['docs', 'support', 'crm', 'hr', 'warehouse', 'comms'];
	let scenario: Scenario | null = null;
	let protect = false;

	function configFor(s: Scenario | null, on: boolean): J {
		const servers = s ? s.servers : ALL;
		return on ? { servers, gateway: 'reef', task: s ? s.task : 'everything', lock: true } : { servers, gateway: 'direct', task: null, lock: false };
	}

	function setProtect(on: boolean) {
		protect = on;
		const b = $('[data-protect]');
		b.setAttribute('aria-pressed', String(on));
		$('[data-protect-label]').textContent = on ? 'on' : 'off';
		$('[data-dot]').className = `dot ${on ? 'safe' : 'open'}`;
		drawFollowUps();
	}
	$('[data-protect]').addEventListener('click', () => setProtect(!protect));


	function h(tag: string, attrs: J = {}, ...kids: (Node | string | null | false)[]) {
		const el = document.createElement(tag);
		for (const [k, v] of Object.entries(attrs)) {
			if (v === undefined || v === null || v === false) continue;
			if (k === 'class') el.className = v;
			else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
			else el.setAttribute(k, v === true ? '' : String(v));
		}
		for (const kid of kids) if (kid !== null && kid !== false) el.append(kid);
		return el;
	}

	// ---- suggestions ---------------------------------------------------------------------

	function chip(text: string, onclick: () => void, cls = 'chip') {
		return h('button', { type: 'button', class: cls, onclick }, text);
	}

	function drawStart() {
		$('[data-scenarios]').replaceChildren(...SCENARIOS.map((s) => card(s)));
	}

	function card(s: Scenario, picked = false) {
		return h(
			'button',
			{ type: 'button', class: `scenario${picked ? ' picked' : ''}`, onclick: () => runScenario(s) },
			h('strong', {}, s.title),
			h('span', {}, s.blurb),
		);
	}

	function runScenario(s: Scenario, on = protect) {
		scenario = s;
		setProtect(on);
		const p = world.prompts.find((x: J) => x.id === s.prompt);
		ask({ prompt: s.prompt, text: p?.text ?? s.title }, `${s.title} · protection ${on ? 'on' : 'off'}`);
	}

	// After an answer: flip protection and run it again, or try another attack.
	function drawFollowUps() {
		follow.replaceChildren();
		if (running || !lastAsk) return;
		const out: HTMLElement[] = [];
		const again = protect ? 'Turn protection off and ask again' : 'Turn protection on and ask again';
		out.push(
			chip(again, () => {
				setProtect(!protect);
				if (scenario && lastAsk!.prompt === scenario.prompt) runScenario(scenario, protect);
				else ask(lastAsk!);
			}, 'chip alt'),
		);
		for (const s of SCENARIOS.filter((x) => x !== scenario)) out.push(chip(s.title, () => runScenario(s, false)));
		follow.replaceChildren(...out);
	}

	// ---- messages ------------------------------------------------------------------------

	// Scrolling: keep the newest message just above the composer, not the page's footer.
	// Follow new content only while the reader is at the bottom; if they scroll up to read,
	// leave them there and offer a "new messages" button instead.
	const composer = $('[data-composer]');
	const jump = $<HTMLButtonElement>('[data-jump]');
	let following = true;
	let userAt = 0; // when the reader last scrolled by hand (wheel, touch, keys)

	function bottomTarget() {
		const threadBottom = thread.getBoundingClientRect().bottom + window.scrollY;
		return Math.max(0, threadBottom - window.innerHeight + composer.offsetHeight + 12);
	}

	function scrollDown(force = false) {
		if (force) following = true;
		if (!following) {
			if (running) jump.hidden = false;
			return;
		}
		requestAnimationFrame(() => {
			const top = bottomTarget();
			if (Math.abs(window.scrollY - top) > 1) window.scrollTo({ top, behavior: 'auto' });
		});
	}

	// Only the reader's own scrolling decides whether we keep following.
	const byHand = () => (userAt = Date.now());
	window.addEventListener('wheel', byHand, { passive: true });
	window.addEventListener('touchmove', byHand, { passive: true });
	window.addEventListener('keydown', (e) => {
		if (['PageUp', 'PageDown', 'ArrowUp', 'ArrowDown', 'Home', 'End', ' '].includes(e.key) && e.target !== input) byHand();
	});
	window.addEventListener(
		'scroll',
		() => {
			if (!empty.hidden || Date.now() - userAt > 600) return;
			following = window.scrollY >= bottomTarget() - 80;
			if (following) jump.hidden = true;
		},
		{ passive: true },
	);
	// Views (iframes) and the trace change size after they arrive; stay pinned through that.
	new ResizeObserver(() => {
		if (!empty.hidden) return;
		scrollDown();
	}).observe(thread);
	jump.addEventListener('click', () => {
		jump.hidden = true;
		scrollDown(true);
	});

	function userBubble(text: string, note?: string) {
		thread.append(
			h('div', { class: 'msg user' }, note ? h('p', { class: 'msg-note' }, note) : null, h('div', { class: 'bubble' }, text), h('p', { class: 'msg-setup' }, `protection ${protect ? 'on' : 'off'} · ${config.servers.join(', ')}`)),
		);
	}

	function agentMessage() {
		const body = h('div', { class: 'body' });
		const status = h('p', { class: 'status' }, h('span', { class: 'spin' }), 'Starting…');
		const steps = h('ol', { class: 'steps' });
		const summary = h('summary', {}, 'What happened');
		const trace = h('details', { class: 'trace' }, summary, steps);
		const foot = h('p', { class: 'msg-foot' });
		const el = h('div', { class: 'msg agent' }, body, status, trace, foot);
		thread.append(el);
		return { el, body, status, steps, summary, trace, foot };
	}

	async function ask(q: { prompt: string; text: string }, note?: string) {
		if (running || !q.text) return;
		if (q.prompt === 'custom') scenario = null; // free questions go to every in-house server
		config = configFor(scenario, protect);
		running = true;
		lastAsk = q;
		empty.hidden = true;
		newButton.hidden = false;
		follow.replaceChildren();
		lock(true);
		userBubble(q.text, note);
		const m = agentMessage();
		scrollDown(true);

		const earlier = keepHistory ? history.slice(-keepHistory) : [];
		const body: J = {
			scenario: 'playground',
			config: { ...config, prompt: q.prompt, ...(q.prompt === 'custom' ? { text: q.text } : {}) },
			...(earlier.length ? { history: earlier } : {}),
		};
		let answer = '';
		let calls = 0;
		let blocked = 0;
		let runId = '';
		let cost = 0;
		const say = (s: string) => (m.status.lastChild!.textContent = s);
		try {
			await streamRun(API, body, (e: Ev) => {
				switch (e.type) {
					case 'run':
						runId = e.id;
						return;
					case 'usage':
						return;
					case 'tools':
						say(`Connected · ${e.tools.length} tool${e.tools.length === 1 ? '' : 's'} visible`);
						break;
					case 'thinking':
						say('Thinking…');
						break;
					case 'tool_call':
						calls += 1;
						say(`Calling ${e.name}…`);
						break;
					case 'text': {
						answer += (answer ? '\n\n' : '') + e.text;
						m.body.append(h('div', { class: 'bubble' }, e.text));
						scrollDown();
						break;
					}
					case 'tool_result':
						if (e.is_error) blocked += 1;
						if (e.ui && e.data) {
							// MCP Apps: the tool's view renders right in the answer.
							const slot = h('div', { class: 'view' });
							m.body.append(slot);
							void mountView(slot, e.ui, e.input ?? {}, e.data);
							scrollDown();
						}
						showEvent(m.steps, { ...e, ui: undefined });
						return;
					case 'error':
						m.body.append(h('div', { class: 'bubble err' }, e.message));
						break;
					case 'done':
						cost = e.cost_usd ?? 0;
						break;
				}
				showEvent(m.steps, e);
			});
		} catch (err) {
			m.body.append(h('div', { class: 'bubble err' }, (err as Error).message));
		}
		m.status.remove();
		const bits = [`${calls} tool call${calls === 1 ? '' : 's'}`];
		if (blocked) bits.push(`${blocked} refused or failed`);
		m.summary.textContent = `What happened · ${bits.join(' · ')}`;
		if (!m.steps.children.length) m.trace.remove();
		if (runId && answer) {
			const link = runLink(runId);
			const copy = h('button', { type: 'button', class: 'link' }, 'Copy link');
			copy.addEventListener('click', () => navigator.clipboard?.writeText(link).then(() => (copy.textContent = 'Copied')));
			m.foot.append(h('a', { href: link }, 'Replay'), ' · ', copy, cost ? ` · $${cost.toFixed(4)}` : '');
		}
		if (scenario && protect && q.prompt === scenario.prompt) m.el.insertBefore(h('p', { class: 'stopped' }, `Protection: ${scenario.stops}`), m.foot);
		if (answer) history.push({ role: 'user', text: q.text }, { role: 'assistant', text: answer });
		running = false;
		lock(false);
		drawFollowUps();
		scrollDown();
		input.focus();
	}

	function lock(on: boolean) {
		input.disabled = on;
		send.disabled = on || !input.value.trim();
	}

	// ---- composer ------------------------------------------------------------------------

	function grow() {
		input.style.height = 'auto';
		input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
		const n = input.value.length;
		$('[data-count]').textContent = n > maxQ * 0.7 ? `${n}/${maxQ} ·` : '';
		send.disabled = running || !input.value.trim();
	}
	input.addEventListener('input', grow);
	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
			e.preventDefault();
			$<HTMLFormElement>('[data-composer]').requestSubmit();
		}
	});
	$<HTMLFormElement>('[data-composer]').addEventListener('submit', (e) => {
		e.preventDefault();
		const text = input.value.trim();
		if (!text || running) return;
		input.value = '';
		grow();
		ask({ prompt: 'custom', text });
	});

	newButton.addEventListener('click', () => {
		if (running) return;
		history.length = 0;
		lastAsk = null;
		thread.replaceChildren(empty);
		empty.hidden = false;
		newButton.hidden = true;
		follow.replaceChildren();
		jump.hidden = true;
		following = true;
		window.scrollTo({ top: 0 });
	});

	// ---- start ---------------------------------------------------------------------------

	async function start() {
		if (!API) return;
		try {
			const [w, health] = await Promise.all([
				fetch(`${API}/api/world`).then((r) => r.json()),
				fetch(`${API}/health`).then((r) => r.json()).catch(() => ({})),
			]);
			world = w;
			maxQ = w.max_question ?? 280;
			input.maxLength = maxQ;
			keepHistory = health.chat?.history ?? 0;
			if (health.live === false) {
				$('[data-status]').textContent = 'Live runs are paused right now. You can still look around.';
			} else {
				$('[data-status]').textContent = keepHistory
					? ''
					: 'Each message starts a fresh run, so the agent won’t remember earlier answers.';
				input.disabled = false;
			}
			$('[data-status]').hidden = !$('[data-status]').textContent;
			drawStart();
			fromLink();
		} catch {
			$('[data-status]').textContent = 'Couldn’t reach the demo server. Try again in a minute.';
		}
	}
	// Links from elsewhere: ?scenario=<preset id>, or a setup (servers, gw, task, lock, prompt).
	// A link sets things up; it never spends a run until the visitor taps.
	function fromLink() {
		const q = new URLSearchParams(location.search);
		const id = q.get('scenario');
		let s = SCENARIOS.find((x) => x.id === id || (id && x.old.includes(id)));
		let on = false;
		if (id) on = /locked|headcount|pal-view|pushy|injected/.test(id) ? true : q.get('protection') === 'on';
		if (!s && q.get('prompt')) {
			s = SCENARIOS.find((x) => x.prompt === q.get('prompt'));
			on = q.get('gw') === 'reef';
		}
		if (!s) return;
		if (s.id === id) on = q.get('protection') === 'on';
		setProtect(on);
		const cards = $('[data-scenarios]');
		cards.replaceChildren(card(s, true), ...SCENARIOS.filter((x) => x !== s).map((x) => card(x)));
	}

	start();
</script>

<style is:global>
	.wrap.chat {
		max-width: 820px;
		display: flex;
		flex-direction: column;
		min-height: calc(100vh - 8rem);
	}
	.chat .bar {
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1rem 0 0.75rem;
		background: color-mix(in srgb, var(--paper) 85%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--rule);
	}
	.chat .title {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		min-width: 0;
	}
	.chat .title h1 {
		margin: 0;
		font-size: 1.15rem;
	}
	.chat .glyph {
		font-family: var(--font-mono), ui-monospace, monospace;
		color: var(--glow, var(--accent));
		margin-right: 0.2rem;
	}
	.chat .scenario.picked {
		border-color: var(--glow, var(--accent));
		box-shadow: 0 0 0 1px var(--glow-wash, transparent), 0 0 24px var(--glow-wash, transparent);
	}
	.chat .box:focus-within {
		box-shadow: 0 0 0 1px var(--accent), 0 0 30px var(--accent-wash);
	}
	.chat .back {
		font-size: 0.85rem;
		color: var(--ink-3);
		text-decoration: none;
	}
	.chat .bar-actions {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		min-width: 0;
	}
	.chat .switch {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font: inherit;
		font-size: 0.82rem;
		padding: 0.35rem 0.8rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: var(--paper-2);
		color: var(--ink-2);
		cursor: pointer;
	}
	.chat .switch b {
		color: #ff6b6b;
	}
	.chat .switch[aria-pressed='true'] {
		border-color: rgba(79, 240, 180, 0.5);
		box-shadow: 0 0 18px rgba(79, 240, 180, 0.12);
	}
	.chat .switch[aria-pressed='true'] b {
		color: var(--glow, #2e9a5a);
	}
	.chat .switch .dot {
		margin-right: 0.1rem;
	}
	.chat .pill,
	.chat .ghost {
		font: inherit;
		font-size: 0.8rem;
		border: 1px solid var(--rule);
		background: var(--paper-2);
		color: var(--ink);
		border-radius: 999px;
		padding: 0.35rem 0.75rem;
		cursor: pointer;
		max-width: 52vw;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.chat .ghost {
		background: none;
		color: var(--ink-2);
	}
	.chat .dot {
		display: inline-block;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		margin-right: 0.4rem;
		background: var(--ink-3);
		vertical-align: 0.05em;
	}
	.chat .dot.safe {
		background: #2e9a5a;
	}
	.chat .dot.part {
		background: #b8860b;
	}
	.chat .dot.open {
		background: #d64541;
	}

	.chat .setup {
		margin: 0.75rem 0 0;
		padding: 1rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--paper-2);
	}
	.chat .setup-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.chat fieldset {
		border: 0;
		margin: 0;
		padding: 0;
		min-width: 0;
	}
	.chat legend {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-3);
		margin-bottom: 0.5rem;
	}
	.chat .checks {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
	}
	.chat .check,
	.chat .seg label {
		font-size: 0.9rem;
		cursor: pointer;
	}
	.chat .seg {
		display: flex;
		gap: 1rem;
		margin-bottom: 0.6rem;
	}
	.chat .row {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		font-size: 0.9rem;
	}
	.chat select {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.25rem 0.4rem;
		border-radius: 6px;
		border: 1px solid var(--rule);
		background: var(--paper);
		color: var(--ink);
	}
	.chat .hint,
	.chat .muted {
		font-size: 0.8rem;
		color: var(--ink-3);
		margin: 0.5rem 0;
	}

	.chat .thread {
		flex: 1;
		padding: 1.5rem 0 1rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.chat .intro {
		color: var(--ink-2);
		margin: 0 0 1rem;
	}
	.chat .label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-3);
		margin: 1.5rem 0 0.6rem;
	}
	.chat .scenarios {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		gap: 0.6rem;
	}
	.chat .scenario {
