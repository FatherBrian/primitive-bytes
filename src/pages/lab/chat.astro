---
// The agent chat: a live agent over sample MCP servers, behind a chat. Each message is one
// live run; MCP Apps views render inline in the answer, and the full trace (tool calls,
// results, ledger, what each server received) folds away under it.
import Page from '../../layouts/Page.astro';
import { url } from '../../url';

const api = import.meta.env.PUBLIC_DEMO_API ?? '';
---

<Page
	title="Chat with an agent"
	description="Chat with an agent wired to real MCP servers, some of them hostile. Change what it can reach, put a gateway in front, and watch every tool call, view and ledger entry."
>
	<section class="chat wrap console" data-chat data-api={api}>
		<header class="bar">
			<div class="title">
				<a class="back" href={url('/lab/')}>← Lab</a>
				<h1><span class="glyph">›_</span> Agent chat</h1>
			</div>
			<div class="bar-actions">
				<button type="button" class="pill" data-open-setup aria-expanded="false" aria-controls="setup">
					<span class="dot" data-dot></span><span data-setup-label>Setup</span>
				</button>
				<button type="button" class="ghost" data-new hidden>New chat</button>
			</div>
		</header>

		<div class="setup" id="setup" data-setup hidden>
			<div class="setup-grid">
				<fieldset>
					<legend>Servers it can reach</legend>
					<div class="checks" data-servers></div>
				</fieldset>
				<fieldset>
					<legend>Gateway</legend>
					<div class="seg">
						<label><input type="radio" name="gateway" value="direct" /> Direct</label>
						<label><input type="radio" name="gateway" value="reef" /> Through Reef</label>
					</div>
					<div data-reef-opts>
						<label class="row">
							<span>Grant</span>
							<select name="task" data-task></select>
						</label>
						<p class="hint" data-task-blurb></p>
						<label class="check"><input type="checkbox" name="lock" /> Pin tools with <code>reef.lock</code></label>
					</div>
				</fieldset>
			</div>
			<p class="hint">Changes apply to your next message.</p>
		</div>

		<div class="thread" data-thread aria-live="polite">
			<div class="empty" data-empty>
				<p class="intro">
					This agent is the internal assistant at a made-up company, wired to real MCP servers: a
					wiki, support tickets, a CRM, HR, a sales warehouse, mail, and a third-party plugin. Some
					of those servers misbehave. Ask it something, then change its setup and ask again.
				</p>
				<p class="muted" data-status>{api ? 'Loading…' : 'The chat needs the demo server, which isn’t set up here.'}</p>
				<h2 class="label" data-scen-label hidden>Scenarios</h2>
				<div class="scenarios" data-scenarios></div>
				<h2 class="label" data-sugg-label hidden>Or just ask</h2>
				<div class="chips" data-suggestions></div>
			</div>
		</div>

		<form class="composer" data-composer>
			<button type="button" class="jump" data-jump hidden>↓ New messages</button>
			<div class="follow chips" data-follow></div>
			<div class="box">
				<textarea name="text" rows="1" placeholder="Ask the agent…" data-input disabled></textarea>
				<button type="submit" class="send" data-send disabled aria-label="Send">↑</button>
			</div>
			<p class="foot">
				<span data-count></span>
				Claude Haiku 5.5 on fake data. Your own questions get a share link but never appear in the
				public feed; don't type anything personal.
			</p>
		</form>
	</section>
</Page>

<script>
	import { mountView, configureViews } from '../../components/demo/views';
	import { runLink, showEvent, streamRun, type Ev } from '../../components/demo/transcript';

	type J = Record<string, any>;
	const root = document.querySelector<HTMLElement>('[data-chat]')!;
	const API = root.dataset.api ?? '';
	configureViews(API);
	const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

	const thread = $('[data-thread]');
	const empty = $('[data-empty]');
	const input = $<HTMLTextAreaElement>('[data-input]');
	const send = $<HTMLButtonElement>('[data-send]');
	const follow = $('[data-follow]');
	const setupPanel = $('[data-setup]');
	const setupButton = $<HTMLButtonElement>('[data-open-setup]');
	const newButton = $<HTMLButtonElement>('[data-new]');

	let world: J = {};
	let maxQ = 280;
	let keepHistory = 0; // how many earlier messages the server takes (0: each message starts fresh)
	let running = false;
	let lastAsk: { prompt: string; text: string } | null = null;
	const history: { role: 'user' | 'assistant'; text: string }[] = [];
	let config: J = { servers: ['docs', 'comms'], gateway: 'reef', task: 'everything', lock: true };

	function h(tag: string, attrs: J = {}, ...kids: (Node | string | null | false)[]) {
		const el = document.createElement(tag);
		for (const [k, v] of Object.entries(attrs)) {
			if (v === undefined || v === null || v === false) continue;
			if (k === 'class') el.className = v;
			else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
			else el.setAttribute(k, v === true ? '' : String(v));
		}
		for (const kid of kids) if (kid !== null && kid !== false) el.append(kid);
		return el;
	}

	// ---- setup ---------------------------------------------------------------------------

	function setupLabel(c: J) {
		const servers = c.servers.join(', ') || 'no servers';
		if (c.gateway === 'direct') return `${servers} · direct`;
		const task = world.tasks?.find((t: J) => t.id === c.task);
		return `${servers} · Reef${task ? ` (${task.label})` : ''}${c.lock ? ' · lock' : ''}`;
	}

	function drawSetup() {
		$('[data-setup-label]').textContent = setupLabel(config);
		$('[data-dot]').className = `dot ${config.gateway === 'reef' ? (config.lock ? 'safe' : 'part') : 'open'}`;
		for (const el of Array.from(setupPanel.querySelectorAll<HTMLInputElement>('input'))) {
			if (el.name === 'servers') el.checked = config.servers.includes(el.value);
			if (el.name === 'gateway') el.checked = el.value === config.gateway;
			if (el.name === 'lock') el.checked = !!config.lock;
		}
		const sel = $<HTMLSelectElement>('[data-task]');
		if (config.task) sel.value = config.task;
		$('[data-reef-opts]').hidden = config.gateway !== 'reef';
		const task = world.tasks?.find((t: J) => t.id === sel.value);
		$('[data-task-blurb]').textContent = task ? `${task.blurb} Scope: ${task.scope.join(', ')}; actions: ${task.actions.join(', ')}.` : '';
	}

	function readSetup() {
		const pick = (name: string) => Array.from(setupPanel.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`));
		const gateway = pick('gateway').find((e) => e.checked)?.value === 'direct' ? 'direct' : 'reef';
		config = {
			servers: pick('servers').filter((e) => e.checked).map((e) => e.value),
			gateway,
			task: gateway === 'reef' ? $<HTMLSelectElement>('[data-task]').value || 'everything' : null,
			lock: gateway === 'reef' && pick('lock')[0]?.checked,
		};
		drawSetup();
		drawFollowUps();
	}

	function buildSetup() {
		$('[data-servers]').replaceChildren(
			...world.servers.map((s: J) =>
				h('label', { class: 'check', title: s.about ?? '' }, h('input', { type: 'checkbox', name: 'servers', value: s.name }), ` ${String(s.title ?? s.name).replace(/^Kelpworks\s+/, '')}`),
			),
		);
		$('[data-task]').replaceChildren(...world.tasks.map((t: J) => h('option', { value: t.id }, t.label)));
		setupPanel.addEventListener('change', readSetup);
		drawSetup();
	}

	setupButton.addEventListener('click', () => {
		setupPanel.hidden = !setupPanel.hidden;
		setupButton.setAttribute('aria-expanded', String(!setupPanel.hidden));
	});

	// ---- suggestions ---------------------------------------------------------------------

	function chip(text: string, onclick: () => void, cls = 'chip') {
		return h('button', { type: 'button', class: cls, onclick }, text);
	}

	function drawStart() {
		const presets = (world.presets ?? []).filter((p: J) => !p.compare);
		$('[data-scen-label]').hidden = !presets.length;
		$('[data-scenarios]').replaceChildren(
			...presets.slice(0, 6).map((p: J) =>
				h(
					'button',
					{ type: 'button', class: 'scenario', onclick: () => runPreset(p) },
					h('strong', {}, p.label),
					h('span', {}, p.blurb),
				),
			),
		);
		$('[data-sugg-label]').hidden = !world.prompts?.length;
		$('[data-suggestions]').replaceChildren(...(world.prompts ?? []).map((p: J) => chip(p.text, () => ask({ prompt: p.id, text: p.text }))));
	}

	// After an answer: change one thing and ask again, or ask something else.
	function drawFollowUps() {
		follow.replaceChildren();
		if (running || !lastAsk) return;
		const again = (label: string, next: J) =>
			chip(label, () => {
				config = { ...config, ...next };
				drawSetup();
				ask(lastAsk!);
			}, 'chip alt');
		const out: HTMLElement[] = [];
		if (config.gateway === 'direct') out.push(again('Ask again through Reef with the lock', { gateway: 'reef', task: 'everything', lock: true }));
		else {
			out.push(again(config.lock ? 'Ask again without the lock' : 'Ask again with the lock', { lock: !config.lock }));
			out.push(again('Ask again with no gateway', { gateway: 'direct', task: null, lock: false }));
		}
		const asked = new Set(history.filter((m) => m.role === 'user').map((m) => m.text));
		for (const p of (world.prompts ?? []).filter((p: J) => !asked.has(p.text)).slice(0, 2)) {
			out.push(chip(p.label, () => ask({ prompt: p.id, text: p.text })));
		}
		follow.replaceChildren(...out);
	}

	function runPreset(p: J) {
		const { prompt, text, ...c } = p.config;
		config = { ...config, ...c };
		drawSetup();
		const known = world.prompts.find((x: J) => x.id === prompt);
		ask({ prompt, text: known?.text ?? text ?? '' }, p.label);
	}

	// ---- messages ------------------------------------------------------------------------

	// Scrolling: keep the newest message just above the composer, not the page's footer.
	// Follow new content only while the reader is at the bottom; if they scroll up to read,
	// leave them there and offer a "new messages" button instead.
	const composer = $('[data-composer]');
	const jump = $<HTMLButtonElement>('[data-jump]');
	let following = true;
	let userAt = 0; // when the reader last scrolled by hand (wheel, touch, keys)

	function bottomTarget() {
		const threadBottom = thread.getBoundingClientRect().bottom + window.scrollY;
		return Math.max(0, threadBottom - window.innerHeight + composer.offsetHeight + 12);
	}

	function scrollDown(force = false) {
		if (force) following = true;
		if (!following) {
			if (running) jump.hidden = false;
			return;
		}
		requestAnimationFrame(() => {
			const top = bottomTarget();
			if (Math.abs(window.scrollY - top) > 1) window.scrollTo({ top, behavior: 'auto' });
		});
	}

	// Only the reader's own scrolling decides whether we keep following.
	const byHand = () => (userAt = Date.now());
	window.addEventListener('wheel', byHand, { passive: true });
	window.addEventListener('touchmove', byHand, { passive: true });
	window.addEventListener('keydown', (e) => {
		if (['PageUp', 'PageDown', 'ArrowUp', 'ArrowDown', 'Home', 'End', ' '].includes(e.key) && e.target !== input) byHand();
	});
	window.addEventListener(
		'scroll',
		() => {
			if (!empty.hidden || Date.now() - userAt > 600) return;
			following = window.scrollY >= bottomTarget() - 80;
			if (following) jump.hidden = true;
		},
		{ passive: true },
	);
	// Views (iframes) and the trace change size after they arrive; stay pinned through that.
	new ResizeObserver(() => {
		if (!empty.hidden) return;
		scrollDown();
	}).observe(thread);
	jump.addEventListener('click', () => {
		jump.hidden = true;
		scrollDown(true);
	});

	function userBubble(text: string, note?: string) {
		thread.append(
			h('div', { class: 'msg user' }, note ? h('p', { class: 'msg-note' }, note) : null, h('div', { class: 'bubble' }, text), h('p', { class: 'msg-setup' }, setupLabel(config))),
		);
	}

	function agentMessage() {
		const body = h('div', { class: 'body' });
		const status = h('p', { class: 'status' }, h('span', { class: 'spin' }), 'Starting…');
		const steps = h('ol', { class: 'steps' });
		const summary = h('summary', {}, 'What happened');
		const trace = h('details', { class: 'trace' }, summary, steps);
		const foot = h('p', { class: 'msg-foot' });
		const el = h('div', { class: 'msg agent' }, body, status, trace, foot);
		thread.append(el);
		return { el, body, status, steps, summary, trace, foot };
	}

	async function ask(q: { prompt: string; text: string }, note?: string) {
		if (running || !q.text) return;
		if (!config.servers.length) {
			setupPanel.hidden = false;
			return;
		}
		running = true;
		lastAsk = q;
		empty.hidden = true;
		newButton.hidden = false;
		follow.replaceChildren();
		lock(true);
		userBubble(q.text, note);
		const m = agentMessage();
		scrollDown(true);

		const earlier = keepHistory ? history.slice(-keepHistory) : [];
		const body: J = {
			scenario: 'playground',
			config: { ...config, prompt: q.prompt, ...(q.prompt === 'custom' ? { text: q.text } : {}) },
			...(earlier.length ? { history: earlier } : {}),
		};
		let answer = '';
		let calls = 0;
		let blocked = 0;
		let runId = '';
		let cost = 0;
		const say = (s: string) => (m.status.lastChild!.textContent = s);
		try {
			await streamRun(API, body, (e: Ev) => {
				switch (e.type) {
					case 'run':
						runId = e.id;
						return;
					case 'usage':
						return;
					case 'tools':
						say(`Connected · ${e.tools.length} tool${e.tools.length === 1 ? '' : 's'} visible`);
						break;
					case 'thinking':
						say('Thinking…');
						break;
					case 'tool_call':
						calls += 1;
						say(`Calling ${e.name}…`);
						break;
					case 'text': {
						answer += (answer ? '\n\n' : '') + e.text;
						m.body.append(h('div', { class: 'bubble' }, e.text));
						scrollDown();
						break;
					}
					case 'tool_result':
						if (e.is_error) blocked += 1;
						if (e.ui && e.data) {
							// MCP Apps: the tool's view renders right in the answer.
							const slot = h('div', { class: 'view' });
							m.body.append(slot);
							void mountView(slot, e.ui, e.input ?? {}, e.data);
							scrollDown();
						}
						showEvent(m.steps, { ...e, ui: undefined });
						return;
					case 'error':
						m.body.append(h('div', { class: 'bubble err' }, e.message));
						break;
					case 'done':
						cost = e.cost_usd ?? 0;
						break;
				}
				showEvent(m.steps, e);
			});
		} catch (err) {
			m.body.append(h('div', { class: 'bubble err' }, (err as Error).message));
		}
		m.status.remove();
		const bits = [`${calls} tool call${calls === 1 ? '' : 's'}`];
		if (blocked) bits.push(`${blocked} refused or failed`);
		m.summary.textContent = `What happened · ${bits.join(' · ')}`;
		if (!m.steps.children.length) m.trace.remove();
		if (runId && answer) {
			const link = runLink(runId);
			const copy = h('button', { type: 'button', class: 'link' }, 'Copy link');
			copy.addEventListener('click', () => navigator.clipboard?.writeText(link).then(() => (copy.textContent = 'Copied')));
			m.foot.append(h('a', { href: link }, 'Replay'), ' · ', copy, cost ? ` · $${cost.toFixed(4)}` : '');
		}
		if (answer) history.push({ role: 'user', text: q.text }, { role: 'assistant', text: answer });
		running = false;
		lock(false);
		drawFollowUps();
		scrollDown();
		input.focus();
	}

	function lock(on: boolean) {
		input.disabled = on;
		send.disabled = on || !input.value.trim();
	}

	// ---- composer ------------------------------------------------------------------------

	function grow() {
		input.style.height = 'auto';
		input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
		const n = input.value.length;
		$('[data-count]').textContent = n > maxQ * 0.7 ? `${n}/${maxQ} ·` : '';
		send.disabled = running || !input.value.trim();
	}
	input.addEventListener('input', grow);
	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
			e.preventDefault();
			$<HTMLFormElement>('[data-composer]').requestSubmit();
		}
	});
	$<HTMLFormElement>('[data-composer]').addEventListener('submit', (e) => {
		e.preventDefault();
		const text = input.value.trim();
		if (!text || running) return;
		input.value = '';
		grow();
		ask({ prompt: 'custom', text });
	});

	newButton.addEventListener('click', () => {
		if (running) return;
		history.length = 0;
		lastAsk = null;
		thread.replaceChildren(empty);
		empty.hidden = false;
		newButton.hidden = true;
		follow.replaceChildren();
		jump.hidden = true;
		following = true;
		window.scrollTo({ top: 0 });
	});

	// ---- start ---------------------------------------------------------------------------

	async function start() {
		if (!API) return;
		try {
			const [w, health] = await Promise.all([
				fetch(`${API}/api/world`).then((r) => r.json()),
				fetch(`${API}/health`).then((r) => r.json()).catch(() => ({})),
			]);
			world = w;
			maxQ = w.max_question ?? 280;
			input.maxLength = maxQ;
			keepHistory = health.chat?.history ?? 0;
			if (health.live === false) {
				$('[data-status]').textContent = 'Live runs are paused right now. You can still look around.';
			} else {
				$('[data-status]').textContent = keepHistory
					? ''
					: 'Each message starts a fresh run, so the agent won’t remember earlier answers.';
				input.disabled = false;
			}
			$('[data-status]').hidden = !$('[data-status]').textContent;
			buildSetup();
			drawStart();
			fromLink();
		} catch {
			$('[data-status]').textContent = 'Couldn’t reach the demo server. Try again in a minute.';
		}
	}
	// Links from elsewhere: ?scenario=<preset id>, or a setup (servers, gw, task, lock, prompt).
	// A link sets things up; it never spends a run until the visitor taps.
	function fromLink() {
		const q = new URLSearchParams(location.search);
		const preset = (world.presets ?? []).find((p: J) => p.id === q.get('scenario'));
		let prompt: J | undefined;
		if (preset) {
			const { prompt: pid, text, ...c } = preset.config;
			config = { ...config, ...c };
			prompt = world.prompts.find((x: J) => x.id === pid);
		} else if (q.get('servers')) {
			const known = new Set(world.servers.map((s: J) => s.name));
			const gw = q.get('gw') === 'direct' ? 'direct' : 'reef';
			config = {
				servers: q.get('servers')!.split(',').filter((s) => known.has(s)),
				gateway: gw,
				task: gw === 'reef' ? q.get('task') || 'everything' : null,
				lock: gw === 'reef' && q.get('lock') === '1',
			};
			prompt = world.prompts.find((x: J) => x.id === q.get('prompt'));
		} else return;
		drawSetup();
		const pick = h(
			'button',
			{ type: 'button', class: 'scenario picked', onclick: () => (preset ? runPreset(preset) : ask({ prompt: prompt!.id, text: prompt!.text })) },
			h('strong', {}, preset ? preset.label : 'From your link'),
			h('span', {}, prompt ? `Tap to ask: “${prompt.text}”` : setupLabel(config)),
		);
		if (prompt || preset) $('[data-scenarios]').prepend(pick);
		$('[data-scen-label]').hidden = false;
	}

	start();
</script>

<style is:global>
	.wrap.chat {
		max-width: 820px;
		display: flex;
		flex-direction: column;
		min-height: calc(100vh - 8rem);
	}
	.chat .bar {
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1rem 0 0.75rem;
		background: color-mix(in srgb, var(--paper) 85%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--rule);
	}
	.chat .title {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		min-width: 0;
	}
	.chat .title h1 {
		margin: 0;
		font-size: 1.15rem;
	}
	.chat .glyph {
		font-family: var(--font-mono), ui-monospace, monospace;
		color: var(--glow, var(--accent));
		margin-right: 0.2rem;
	}
	.chat .scenario.picked {
		border-color: var(--glow, var(--accent));
		box-shadow: 0 0 0 1px var(--glow-wash, transparent), 0 0 24px var(--glow-wash, transparent);
	}
	.chat .box:focus-within {
		box-shadow: 0 0 0 1px var(--accent), 0 0 30px var(--accent-wash);
	}
	.chat .back {
		font-size: 0.85rem;
		color: var(--ink-3);
		text-decoration: none;
	}
	.chat .bar-actions {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		min-width: 0;
	}
	.chat .pill,
	.chat .ghost {
		font: inherit;
		font-size: 0.8rem;
		border: 1px solid var(--rule);
		background: var(--paper-2);
		color: var(--ink);
		border-radius: 999px;
		padding: 0.35rem 0.75rem;
		cursor: pointer;
		max-width: 52vw;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.chat .ghost {
		background: none;
		color: var(--ink-2);
	}
	.chat .dot {
		display: inline-block;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		margin-right: 0.4rem;
		background: var(--ink-3);
		vertical-align: 0.05em;
	}
	.chat .dot.safe {
		background: #2e9a5a;
	}
	.chat .dot.part {
		background: #b8860b;
	}
	.chat .dot.open {
		background: #d64541;
	}

	.chat .setup {
		margin: 0.75rem 0 0;
		padding: 1rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--paper-2);
	}
	.chat .setup-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.chat fieldset {
