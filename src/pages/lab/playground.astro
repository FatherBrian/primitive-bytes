---
// The playground: wire up an agent in Kelpworks, then run it with a real model.
import Transcript from '../../components/demo/Transcript.astro';
import Page from '../../layouts/Page.astro';
import { url } from '../../url';

const api = import.meta.env.PUBLIC_DEMO_API ?? '';
---

<Page
	title="Agent playground"
	description="Wire up an agent in Kelpworks: pick its servers, its gateway, its grant and a task, then run it with a real model and watch what gets through."
>
	<section class="wrap head">
		<a class="back eyebrow" href={url('/lab/')}>← Lab</a>
		<h1>Agent playground</h1>
		<p class="dek">
			Wire up an agent in <a href={url('/lab/explore/')}>Kelpworks</a>: which servers it can
			reach, whether it goes through Reef, on what grant, and what you ask it. Then run it with a
			real model and see what happens. Start from a preset or build your own.
		</p>
	</section>

	<section class="wrap" data-play data-api={api}>
		<h2 class="label">Presets</h2>
		<div class="presets" data-presets>
			<p class="muted">{api ? 'Loading…' : 'The playground needs the demo server, which isn’t set up here.'}</p>
		</div>

		<div class="grid">
			<form class="config" data-config hidden>
				<fieldset>
					<legend><span>1</span> Ask</legend>
					<div class="prompts" data-prompts></div>
					<div class="own" data-own hidden>
						<textarea name="text" rows="3" data-text placeholder="Ask Kelpworks's agent anything it could do with these servers."></textarea>
						<p class="hint">
							<span data-count></span> Your own questions get a share link, but never show up in the
							public list of runs. Don't type anything personal.
						</p>
					</div>
				</fieldset>
				<fieldset>
					<legend><span>2</span> Connect servers</legend>
					<div class="servers" data-servers></div>
				</fieldset>
				<fieldset>
					<legend><span>3</span> Gateway</legend>
					<div class="seg" data-gateway>
						<label><input type="radio" name="gateway" value="direct" /> Direct</label>
						<label><input type="radio" name="gateway" value="reef" /> Through Reef</label>
					</div>
					<div class="reef-opts" data-reef-opts>
						<label class="row">
							<span>Grant</span>
							<select name="task" data-task></select>
						</label>
						<p class="hint" data-task-blurb></p>
						<label class="check">
							<input type="checkbox" name="lock" /> Pin tools with <code>reef.lock</code>
						</label>
					</div>
				</fieldset>
				<p class="summary" data-summary></p>
				<label class="row compare">
					<span>Compare with</span>
					<select name="vs" data-vs></select>
				</label>
				<button type="submit" class="run" data-run>Run with Claude Haiku 5.5</button>
				<p class="hint">A real model on fake data, about a tenth of a cent a run. A few runs per visitor every ten minutes.</p>
			</form>

			<div class="output">
				<div class="side" data-side="a">
					<p class="side-label" data-label hidden>Your setup</p>
					<p class="note" data-note>Pick a preset, or set things up on the left, then run it.</p>
					<Transcript />
					<p class="share" data-share hidden></p>
				</div>
				<div class="side" data-side="b" hidden>
					<p class="side-label" data-label></p>
					<p class="note" data-note></p>
					<Transcript />
					<p class="share" data-share hidden></p>
				</div>
			</div>
		</div>
	</section>
</Page>

<script>
	import { configureViews, shareLink, showEvent, streamRun, type Ev } from '../../components/demo/transcript';

	type J = Record<string, any>;
	const root = document.querySelector<HTMLElement>('[data-play]')!;
	const API = root.dataset.api ?? '';
	configureViews(API);
	const form = root.querySelector<HTMLFormElement>('[data-config]')!;
	const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
	const runButton = q<HTMLButtonElement>('[data-run]');
	const vsSelect = q<HTMLSelectElement>('[data-vs]');
	const sides = ['a', 'b'].map((s) => {
		const el = q(`[data-side="${s}"]`);
		const pick = (sel: string) => el.querySelector<HTMLElement>(sel)!;
		return { el, label: pick('[data-label]'), note: pick('[data-note]'), steps: pick('[data-steps]'), share: pick('[data-share]') };
	});
	let world: J;
	let running = false;
	let variants: { label: string; config: J }[] = [];

	function h(tag: string, attrs: J = {}, ...kids: (Node | string | null | false)[]) {
		const el = document.createElement(tag);
		for (const [k, v] of Object.entries(attrs)) {
			if (v === undefined || v === null || v === false) continue;
			if (k === 'class') el.className = v;
			else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
			else el.setAttribute(k, v === true ? '' : String(v));
		}
		for (const kid of kids) if (kid !== null && kid !== false) el.append(kid);
		return el;
	}

	function read(): J {
		const data = new FormData(form);
		const gateway = data.get('gateway') === 'reef' ? 'reef' : 'direct';
		return {
			servers: data.getAll('servers'),
			gateway,
			task: gateway === 'reef' ? data.get('task') : null,
			lock: gateway === 'reef' && data.get('lock') === 'on',
			prompt: data.get('prompt'),
			...(data.get('prompt') === 'custom' ? { text: String(data.get('text') ?? '').trim() } : {}),
		};
	}

	function compared(): J | null {
		const i = Number(vsSelect.value);
		return vsSelect.value !== '' && variants[i] ? variants[i].config : null;
	}

	function write(c: J, vs: J | null = null) {
		for (const el of Array.from(form.elements) as HTMLInputElement[]) {
			if (el.name === 'servers') el.checked = c.servers.includes(el.value);
			if (el.name === 'gateway') el.checked = el.value === c.gateway;
			if (el.name === 'prompt') el.checked = el.value === c.prompt;
			if (el.name === 'lock') el.checked = !!c.lock;
		}
		if (c.task) q<HTMLSelectElement>('[data-task]').value = c.task;
		drawVariants(c, vs);
		changed();
	}

	// One change away from the current setup: what's worth comparing against.
	function makeVariants(c: J): { label: string; config: J }[] {
		const out: { label: string; config: J }[] = [];
		if (c.gateway === 'reef') {
			out.push({ label: c.lock ? 'the same, without the lock' : 'the same, with the lock', config: { ...c, lock: !c.lock } });
			out.push({ label: 'the same, with no gateway', config: { ...c, gateway: 'direct', task: null, lock: false } });
			for (const t of world.tasks) if (t.id !== c.task) out.push({ label: `the same, on the “${t.label}” grant`, config: { ...c, task: t.id } });
		} else {
			out.push({ label: 'the same, through Reef with the lock', config: { ...c, gateway: 'reef', task: 'everything', lock: true } });
		}
		if (c.servers.length > 1) {
			for (const s of c.servers) out.push({ label: `the same, without ${s}`, config: { ...c, servers: c.servers.filter((x: string) => x !== s) } });
		}
		return out;
	}

	// keep: a config to select (from a preset or the URL); otherwise keep the same choice by name.
	function drawVariants(c: J, keep: J | null) {
		const label = keep ? null : variants[Number(vsSelect.value)]?.label;
		const hadOne = vsSelect.value !== '';
		variants = makeVariants(c);
		vsSelect.replaceChildren(h('option', { value: '' }, 'nothing, just run it'), ...variants.map((v, i) => h('option', { value: String(i) }, v.label)));
		const again = keep ? variants.findIndex((v) => same(v.config, keep)) : hadOne ? variants.findIndex((v) => v.label === label) : -1;
		vsSelect.value = again >= 0 ? String(again) : '';
	}

	function describe(c: J) {
		const task = world.tasks.find((t: J) => t.id === c.task);
		const servers = c.servers.length ? c.servers.join(', ') : 'nothing yet';
		return c.gateway === 'direct'
			? `The agent connects straight to ${servers}. Nothing checks, masks or pins anything.`
			: `The agent reaches ${servers} through Reef, on the “${task?.label}” grant, ${c.lock ? 'with tools pinned by the lock' : 'without a lock'}.`;
	}

	function changed(ev?: Event) {
		const c = read();
		if (ev && (ev.target as HTMLElement).getAttribute('name') !== 'vs') drawVariants(c, null);
		q('[data-reef-opts]').hidden = c.gateway !== 'reef';
		const task = world.tasks.find((t: J) => t.id === q<HTMLSelectElement>('[data-task]').value);
		q('[data-task-blurb]').textContent = task ? `${task.blurb} Scope: ${task.scope.join(', ')}; actions: ${task.actions.join(', ')}.` : '';
		q('[data-summary]').textContent = describe(c);
		const vs = compared();
		runButton.textContent = vs ? 'Run both with Claude Haiku 5.5' : 'Run with Claude Haiku 5.5';
		const own = c.prompt === 'custom';
		q('[data-own]').hidden = !own;
		const max = world.max_question ?? 280;
		const textArea = q<HTMLTextAreaElement>('[data-text]');
		textArea.maxLength = max;
		q('[data-count]').textContent = `${textArea.value.length}/${max}.`;
		runButton.disabled =
			running || !c.servers.length || !c.prompt || (own && (c.text ?? '').length < 3) || (vs !== null && !vs.servers.length);
		for (const card of root.querySelectorAll<HTMLElement>('.preset')) {
			const p = JSON.parse(card.dataset.preset!);
			card.classList.toggle('on', same(p.config, c) && (p.compare ? !!vs && same(p.compare, vs) : !vs));
		}
		save(c, vs);
	}

	function same(a: J, b: J) {
		const norm = (c: J) => JSON.stringify({ servers: [...c.servers].sort(), gateway: c.gateway, task: c.gateway === 'reef' ? c.task : null, lock: c.gateway === 'reef' && !!c.lock, prompt: c.prompt });
		return norm(a) === norm(b);
	}

	function params(c: J, prefix = '') {
		const p: [string, string][] = [[`${prefix}servers`, c.servers.join(',')], [`${prefix}gw`, c.gateway]];
		if (c.gateway === 'reef') p.push([`${prefix}task`, c.task], [`${prefix}lock`, c.lock ? '1' : '0']);
		return p;
	}

	function save(c: J, vs: J | null) {
		const p = new URLSearchParams([...params(c), ['prompt', c.prompt ?? '']]);
		if (vs) for (const [k, v] of params(vs, 'vs_')) p.set(k, v);
		history.replaceState(null, '', `${location.pathname}?${p}`);
	}

	function parseURL(p: URLSearchParams, prefix: string, prompt: string | null): J | null {
		if (!p.get(`${prefix}servers`)) return null;
		return {
			servers: p.get(`${prefix}servers`)!.split(',').filter((s) => world.servers.some((x: J) => x.name === s)),
			gateway: p.get(`${prefix}gw`) === 'reef' ? 'reef' : 'direct',
			task: p.get(`${prefix}task`),
			lock: p.get(`${prefix}lock`) === '1',
			prompt,
		};
	}

	function fromURL(): [J, J | null] | null {
		const p = new URLSearchParams(location.search);
		const preset = world.presets.find((x: J) => x.id === p.get('preset'));
		if (preset) return [preset.config, preset.compare ?? null];
		const c = parseURL(p, '', p.get('prompt'));
		return c ? [c, parseURL(p, 'vs_', p.get('prompt'))] : null;
	}

	function draw() {
		q('[data-presets]').replaceChildren(
			...world.presets.map((p: J) =>
				h('button', { type: 'button', class: `preset ${p.compare ? 'pair' : ''}`, 'data-preset': JSON.stringify(p), onclick: () => { write(p.config, p.compare ?? null); if (matchMedia('(max-width: 860px)').matches) form.scrollIntoView({ behavior: 'smooth' }); } },
					h('b', {}, p.label), h('span', {}, p.blurb)),
			),
		);
		q('[data-prompts]').replaceChildren(
			...world.prompts.map((p: J) => h('label', { class: 'prompt' }, h('input', { type: 'radio', name: 'prompt', value: p.id }), h('span', {}, h('b', {}, p.label), h('em', {}, `“${p.text}”`)))),
			h('label', { class: 'prompt' }, h('input', { type: 'radio', name: 'prompt', value: 'custom' }), h('span', {}, h('b', {}, 'Ask your own'), h('em', {}, `Up to ${world.max_question ?? 280} characters.`))),
		);
		q('[data-servers]').replaceChildren(
			...world.servers.map((s: J) => h('label', { class: 'srv' }, h('input', { type: 'checkbox', name: 'servers', value: s.name }), h('span', {}, s.title, s.third_party ? h('i', {}, 'third-party') : null))),
		);
		q('[data-task]').replaceChildren(...world.tasks.map((t: J) => h('option', { value: t.id }, t.label)));
		form.hidden = false;
		const [c, vs] = fromURL() ?? [world.presets[0].config, world.presets[0].compare ?? null];
		write(c, vs);
	}

	async function runOne(side: (typeof sides)[number], config: J) {
		side.steps.replaceChildren();
		side.share.hidden = true;
		side.note.textContent = 'Running…';
		let runId = '';
		try {
			await streamRun(API, { scenario: 'playground', config }, (e: Ev) => {
				if (e.type === 'run') runId = e.id;
				else if (e.type === 'done') {
					side.note.textContent = `Done. This run cost $${Number(e.cost_usd).toFixed(4)}.`;
					if (runId) shareLink(side.share, runId);
				} else showEvent(side.steps, e);
			});
		} catch (e) {
			side.note.textContent = (e as Error).message;
		}
	}

	form.addEventListener('change', changed);
	q('[data-text]').addEventListener('input', () => changed());
	form.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		const config = read();
		const picked = compared();
		// Both sides ask the same question, including the text typed since the variants were drawn.
		const vs = picked ? { ...picked, prompt: config.prompt, text: config.text } : null;
		const comparing = !!vs;
		root.querySelector('.grid')!.classList.toggle('comparing', comparing);
		sides[1].el.hidden = !comparing;
		sides[0].label.hidden = !comparing;
		if (vs) {
			sides[0].label.textContent = `Your setup. ${describe(config)}`;
			sides[1].label.textContent = `Compared: ${variants[Number(vsSelect.value)].label}. ${describe(vs)}`;
		}
		running = true;
		runButton.disabled = true;
		try {
			await Promise.all([runOne(sides[0], config), vs ? runOne(sides[1], vs) : Promise.resolve()]);
		} finally {
			running = false;
			changed();
		}
	});

	async function start() {
		if (!API) return;
		try {
			const res = await fetch(`${API}/api/world`);
			if (!res.ok) throw new Error();
			world = await res.json();
		} catch {
			q('[data-presets]').replaceChildren(h('p', { class: 'muted' }, "Couldn't reach the demo server. Try again in a minute."));
			return;
		}
		draw();
	}
	start();
</script>

<style>
	.head {
		padding-top: 4rem;
		padding-bottom: 0.5rem;
	}
	.back {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--accent-ink);
		text-decoration: none;
	}
	h1 {
		margin-bottom: 0.75rem;
	}
	.dek {
		max-width: 64ch;
		margin: 0;
		color: var(--ink-2);
		font-size: 1.1rem;
		line-height: 1.6;
	}
	.label {
		margin: 2rem 0 0.75rem;
		color: var(--ink-3);
		font-family: var(--font-mono), monospace;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.muted {
		color: var(--ink-3);
	}
	.presets {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.6rem;
	}
	.presets :global(.preset) {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.75rem 0.85rem;
		border: 1px solid var(--rule);
		border-radius: 10px;
		background: var(--paper-2);
		color: var(--ink);
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: border-color 0.15s ease;
	}
	.presets :global(.preset:hover) {
		border-color: var(--accent);
	}
	.presets :global(.preset.on) {
		border-color: var(--accent);
		background: var(--accent-wash);
	}
	.presets :global(.preset b) {
		font-size: 0.9rem;
	}
	.presets :global(.preset span) {
		color: var(--ink-2);
		font-size: 0.8rem;
		line-height: 1.45;
	}

	.grid {
		display: grid;
		grid-template-columns: 360px 1fr;
		gap: 1.5rem;
		align-items: start;
		margin-top: 1.75rem;
	}
	.config {
		position: sticky;
		top: 4.5rem;
		padding: 1.1rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--paper);
	}
	fieldset {
		margin: 0 0 1.1rem;
		padding: 0;
		border: 0;
	}
	legend {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		font-weight: 600;
		font-size: 0.92rem;
	}
	legend span {
		display: inline-grid;
		place-items: center;
		width: 1.3rem;
		height: 1.3rem;
		border-radius: 50%;
		background: var(--accent);
		color: #fff;
		font-size: 0.72rem;
	}
	.prompts {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}
	.prompts :global(.prompt) {
		display: flex;
		gap: 0.5rem;
		align-items: flex-start;
		padding: 0.4rem 0.5rem;
		border-radius: 8px;
		cursor: pointer;
	}
	.prompts :global(.prompt:has(input:checked)) {
		background: var(--accent-wash);
	}
	.prompts :global(.prompt input) {
		margin-top: 0.25rem;
	}
	.prompts :global(.prompt span) {
		display: flex;
		flex-direction: column;
		font-size: 0.86rem;
	}
	.own {
		margin-top: 0.4rem;
	}
	.own[hidden] {
		display: none;
	}
	.own textarea {
		width: 100%;
		padding: 0.5rem 0.6rem;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--paper);
		color: var(--ink);
		font: inherit;
		font-size: 0.88rem;
		resize: vertical;
	}
	.own textarea:focus {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
	.prompts :global(.prompt em) {
		color: var(--ink-3);
		font-size: 0.78rem;
	}
	.servers {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.servers :global(.srv) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		font-size: 0.8rem;
		cursor: pointer;
	}
	.servers :global(.srv:has(input:checked)) {
		border-color: var(--accent);
		background: var(--accent-wash);
	}
	.servers :global(.srv i) {
		margin-left: 0.3rem;
		color: #b8860b;
		font-family: var(--font-mono), monospace;
		font-size: 0.62rem;
		font-style: normal;
	}
	.seg {
		display: inline-flex;
		padding: 0.2rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
	}
	.seg label {
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		font-size: 0.85rem;
		cursor: pointer;
	}
	.seg input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.seg label:has(input:checked) {
		background: var(--ink);
		color: var(--paper);
	}
	.seg label:has(input:focus-visible) {
		outline: 2px solid var(--accent);
	}
	.reef-opts {
		margin-top: 0.7rem;
	}
	.reef-opts[hidden] {
		display: none;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.85rem;
	}
	.row select {
		flex: 1;
		padding: 0.4rem 0.5rem;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--paper);
		color: var(--ink);
		font: inherit;
	}
	.check {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 0.4rem;
		font-size: 0.85rem;
		cursor: pointer;
	}
	.hint {
		margin: 0.35rem 0 0;
		color: var(--ink-3);
		font-size: 0.78rem;
		line-height: 1.45;
	}
	.summary {
		margin: 0 0 0.75rem;
		padding: 0.6rem 0.75rem;
		border-radius: 8px;
		background: var(--paper-2);
		font-size: 0.85rem;
		color: var(--ink-2);
	}
	.run {
		width: 100%;
		padding: 0.65rem 1rem;
		border: 0;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.run:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.output {
		min-width: 0;
	}
	.side {
		min-width: 0;
	}
	.side[hidden] {
		display: none;
	}
	.side-label {
		margin: 0 0 0.6rem;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.45;
	}
	.side-label[hidden] {
		display: none;
	}
	[data-side='b'] .side-label {
		color: var(--accent-ink);
	}
	/* Side by side: the setup on top, the two runs in columns under it. */
	.grid.comparing {
