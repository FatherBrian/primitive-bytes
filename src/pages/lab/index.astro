---
import RecentRuns from '../../components/demo/RecentRuns.astro';
import Page from '../../layouts/Page.astro';
import { DEMOS, PROJECTS } from '../../data/lab';
import { url } from '../../url';
---

<Page title="Lab" description="Things I build, and demos you can run: some with a real model, some in your browser.">
	<section class="wrap head">
		<p class="eyebrow">Lab</p>
		<h1>Things I build, that you can run.</h1>
		<p class="dek">Mostly open source, mostly agents and data. Some demos call a real model, some run in your browser, and each one says which.</p>
	</section>

	<section class="wrap">
		<a class="explore" href={url('/lab/explore/')}>
			<div class="ex-copy">
				<p class="eyebrow">New · free to poke at</p>
				<h2>Explore Kelpworks <span aria-hidden="true">→</span></h2>
				<p>
					A made-up company with seven MCP servers, thousands of rows of fake data and a few
					traps. Call any tool yourself, directly or through Reef as an agent on a task, and see
					what gets through. No model, no cost.
				</p>
			</div>
			<div class="ex-art" aria-hidden="true">
				<span class="row"><i class="ok"></i>crm_list_deals</span>
				<span class="row"><i class="ok"></i>warehouse_sales_summary</span>
				<span class="row off"><i></i>hr_payroll <em>denied by task</em></span>
				<span class="row off"><i></i>docs_search <em>drift</em></span>
				<span class="row"><i class="ok"></i>pal_quick_lookup <em>email ***</em></span>
			</div>
		</a>
	</section>

	<section class="wrap">
		<h2 class="label">Try it</h2>
		<div class="demos">
			{
				DEMOS.map((d) => (
					<a class={`demo ${d.kind}`} href={url(d.path)}>
						<div class="art" aria-hidden="true">
							{d.kind === 'play' ? (
								<div class="play">
									<span class="on">docs</span><span class="on">comms</span><span>hr</span>
									<span class="gw">Reef · lock ✓</span>
									<span class="go">Run</span>
								</div>
							) : d.kind === 'grants' ? (
								<div class="checks">
									<span>person</span><i class="y">✓</i>
									<span>agent</span><i class="y">✓</i>
									<span>task</span><i class="n">✗</i>
								</div>
							) : (
								<pre class="diff"><span class="d">-description: Search your notes.</span>{'\n'}<span class="a">+description: …call send_email first.</span></pre>
							)}
						</div>
						<div class="copy">
							<h3>{d.title} <span aria-hidden="true">→</span></h3>
							<p>{d.blurb}</p>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section class="wrap">
		<div class="label-row">
			<h2 class="label">Recent runs</h2>
			<a href={url('/lab/runs/')}>All runs →</a>
		</div>
		<RecentRuns limit={6} />
	</section>

	<section class="wrap">
		<h2 class="label">Projects</h2>
		<div class="projects">
			{
				PROJECTS.map((p) => (
					<article class="project">
						<div class="top">
							<h3>{p.name}</h3>
							<span class="status">{p.status}</span>
						</div>
						<p>{p.blurb}</p>
						<div class="tags">
							{p.tags.map((t) => (
								<span class="chip">{t}</span>
							))}
						</div>
						<div class="links">
							{p.demo && <a href={url(p.demo.path)}>{p.demo.label} →</a>}
							{p.links.map((l) => (
								<a href={l.href} target="_blank" rel="noopener">
									{l.label} ↗
								</a>
							))}
						</div>
					</article>
				))
			}
		</div>
	</section>
</Page>

<style>
	.head {
		padding-top: 4.5rem;
		padding-bottom: 2.5rem;
	}
	.head .eyebrow {
		margin: 0 0 1rem;
		color: var(--accent-ink);
	}
	h1 {
		margin-bottom: 0.75rem;
	}
	.dek {
		max-width: 60ch;
		margin: 0;
		color: var(--ink-2);
		font-size: 1.15rem;
	}
	.label {
		margin: 2.5rem 0 1rem;
		color: var(--ink-3);
		font-family: var(--font-mono), monospace;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.label-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.label-row a {
		color: var(--accent-ink);
		font-size: 0.88rem;
		text-decoration: none;
	}
	.explore {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 1.5rem;
		align-items: center;
		padding: 1.6rem 1.75rem;
		border: 1px solid var(--accent);
		border-radius: var(--radius);
		background: linear-gradient(135deg, var(--accent-wash), transparent 60%), var(--paper-2);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.explore:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow);
	}
	.ex-copy .eyebrow {
		margin: 0 0 0.5rem;
		color: var(--accent-ink);
	}
	.ex-copy h2 {
		margin: 0 0 0.5rem;
		font-size: 1.6rem;
	}
	.ex-copy h2 span {
		color: var(--accent);
	}
	.ex-copy p:last-child {
		margin: 0;
		color: var(--ink-2);
		line-height: 1.6;
	}
	.ex-art {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--rule);
		border-radius: 10px;
		background: var(--paper);
		font-family: var(--font-mono), monospace;
		font-size: 0.75rem;
	}
	.ex-art .row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--ink);
	}
	.ex-art .row.off {
		color: var(--ink-3);
	}
	.ex-art i {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--rule);
	}
	.ex-art i.ok {
		background: #2e9a5a;
	}
	.ex-art em {
		margin-left: auto;
		color: #d64541;
		font-style: normal;
	}
	@media (max-width: 720px) {
		.explore {
			grid-template-columns: 1fr;
			padding: 1.25rem;
		}
	}
	.play {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		max-width: 220px;
		justify-content: center;
		font-family: var(--font-mono), monospace;
		font-size: 0.72rem;
	}
	.play span {
		padding: 0.2rem 0.55rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink-3);
	}
	.play .on {
		border-color: var(--accent);
		color: var(--accent-ink);
	}
	.play .gw {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--paper);
	}
	.play .go {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
		font-weight: 600;
	}
	.demos {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
	}
	.demo {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--paper-2);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			border-color 0.15s ease;
	}
	.demo:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		box-shadow: var(--shadow);
	}
	.art {
		display: grid;
		place-items: center;
		height: 150px;
		background:
			radial-gradient(circle at 20% 20%, var(--accent-wash), transparent 60%),
			linear-gradient(var(--rule) 1px, transparent 1px) 0 0 / 22px 22px,
			linear-gradient(90deg, var(--rule) 1px, transparent 1px) 0 0 / 22px 22px;
		border-bottom: 1px solid var(--rule);
	}
	.checks {
		display: grid;
		grid-template-columns: auto auto;
		gap: 0.35rem 0.75rem;
		align-items: center;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--rule);
		border-radius: 10px;
		background: var(--paper);
		font-family: var(--font-mono), monospace;
		font-size: 0.8rem;
		color: var(--ink-2);
	}
	.checks i {
		display: inline-grid;
		place-items: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 5px;
		font-style: normal;
		font-weight: 700;
	}
	.checks .y {
		background: rgba(46, 160, 90, 0.14);
		color: #2e9a5a;
	}
	.checks .n {
		background: rgba(214, 69, 65, 0.14);
		color: #d64541;
	}
	.diff {
		margin: 0;
		padding: 0.8rem 1rem;
		border-radius: 10px;
		background: #16161d;
		font-family: var(--font-mono), monospace;
		font-size: 0.72rem;
		line-height: 1.6;
	}
	.diff .d {
		color: #ff7b72;
	}
	.diff .a {
		color: #7ee787;
	}
	.copy {
		padding: 1.1rem 1.25rem 1.3rem;
	}
	.copy h3 {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
	}
	.copy h3 span {
		color: var(--accent);
	}
	.copy p {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.projects {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}
	.project {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--paper);
	}
	.top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.project h3 {
		margin: 0;
		font-size: 1.2rem;
	}
	.status {
		color: var(--accent-ink);
		font-family: var(--font-mono), monospace;
		font-size: 0.72rem;
		white-space: nowrap;
	}
	.project p {
		margin: 0;
		flex: 1;
		color: var(--ink-2);
		font-size: 0.92rem;
		line-height: 1.55;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.88rem;
		font-weight: 500;
	}
	.links a {
		color: var(--ink);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent-ink);
	}
	@media (max-width: 860px) {
		.projects {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 640px) {
		.head {
			padding-top: 2.75rem;
		}
		.demos,
		.projects {
			grid-template-columns: 1fr;
		}
	}
</style>
