---
import { GITHUB_URL } from '../consts';
import Page from '../layouts/Page.astro';
import { url } from '../url';
---

<Page title="About" description="I like data and AI and post about them sometimes, along with random things I build.">
	<article class="wrap">
		<header class="head">
			<p class="eyebrow">About</p>
			<h1>About</h1>
		</header>
		<div class="prose">
			<p>I work on data and AI governance and the platforms around them.</p>
			<p>I like data and AI and post about them sometimes, along with random things I build.</p>
			<p>
				<a href={GITHUB_URL}>GitHub</a> · <a href={url('/rss.xml')}>RSS</a>
			</p>
		</div>
	</article>
</Page>

<style>
	.head {
		max-width: var(--measure);
		margin: 4.5rem auto 2rem;
	}
	.head .eyebrow {
		display: none;
	}
	@media (max-width: 640px) {
		.head {
			margin-top: 2.75rem;
		}
	}
</style>
