---
import FormattedDate from '../components/FormattedDate.astro';
import { url } from '../url';
import Page from './Page.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	minutes?: number;
}

const { title, description, pubDate, updatedDate, tags = [], minutes } = Astro.props;
---

<Page title={title} description={description}>
	<article class="wrap">
		<header class="head">
			<div class="eyebrow meta">
				<FormattedDate date={pubDate} />
				{minutes && (
					<>
						<span aria-hidden="true">·</span>
						<span>{minutes} min read</span>
					</>
				)}
				{updatedDate && (
					<>
						<span aria-hidden="true">·</span>
						<span>
							Updated <FormattedDate date={updatedDate} />
						</span>
					</>
				)}
			</div>
			<h1>{title}</h1>
			<p class="dek">{description}</p>
			{tags.length > 0 && (
				<div class="tags">
					{tags.map((t) => (
						<span class="chip">{t}</span>
					))}
				</div>
			)}
		</header>
		<div class="prose">
			<slot />
		</div>
		<nav class="back">
			<a href={url('/blog/')}>← All writing</a>
		</nav>
	</article>
</Page>

<style>
	.head {
		max-width: var(--measure);
		margin: 4.5rem auto 3rem;
		padding-bottom: 2.25rem;
		border-bottom: 1px solid var(--rule);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
	}
	h1 {
		margin-bottom: 0.9rem;
	}
	.dek {
		margin: 0;
		color: var(--ink-2);
		font-size: 1.2rem;
		line-height: 1.55;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1.4rem;
	}
	.back {
		max-width: var(--measure);
		margin: 4rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}
	.back a {
		color: var(--ink-2);
		font-weight: 500;
		text-decoration: none;
	}
	.back a:hover {
		color: var(--accent-ink);
	}
	@media (max-width: 640px) {
		.head {
			margin-top: 2.5rem;
		}
		.dek {
			font-size: 1.08rem;
		}
	}
</style>
